# Copy to .env and uncomment as needed (loaded via environment when starting scripts/API)

# Config profile: merges config/settings.yaml + config/settings.dev.yaml or settings.prod.yaml
# HEAT_MAP_ENV=dev

# Explicit config file (overrides HEAT_MAP_ENV)
# HEAT_MAP_CONFIG_PATH=config/settings.dev.yaml

# Database (overrides storage.db_url in YAML)
# DB_URL=sqlite:///data/heatmap.db
# DB_URL=postgresql+psycopg2://postgres:password@db.example.com:5432/postgres

# Auth
# AUTH_SECRET_KEY=change-me-in-production

# Dashboard → API URL
# API_BASE_URL=http://localhost:8000

# Override first camera source (USB index, file path, or RTSP URL)
# HEAT_MAP_CAMERA_SOURCE=0
# HEAT_MAP_CAMERA_SOURCE=data/recordings/sample.mp4

# Detection
# DETECTION_DEVICE=cuda:0
